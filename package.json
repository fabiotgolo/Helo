{
  "name": "helo-app",
  "version": "1.2.5",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-version.mjs && next dev --webpack",
    "dev:preview": "node scripts/gen-version.mjs && NEXT_DIST_DIR=.next-preview next dev --webpack",
    "build": "node scripts/gen-version.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "emu": "firebase emulators:start --only firestore --project helo-app-7fbf8",
    "test:access": "node scripts/test-access.mjs",
    "test:activities": "node scripts/test-activities.mjs",
    "test:feedback": "node scripts/test-feedback.mjs",
    "test:realtime-questions": "node scripts/test-realtime-questions.mjs",
    "test:authorship": "node scripts/test-confirmed-patient-statement.mjs",
    "test:session-context": "node scripts/test-session-context.mjs",
    "test:interpretation": "node scripts/test-caregiver-interpretation.mjs",
    "test:patient-controls": "node scripts/test-patient-controls.mjs",
    "test:oc:core": "node scripts/test-option-conversation-core.mjs",
    "test:oc:branches": "node scripts/test-option-conversation-branches.mjs",
    "test:oc:versioning": "node scripts/test-option-conversation-versioning.mjs",
    "test:oc:history": "node scripts/test-option-conversation-history.mjs",
    "test:oc:screen": "node scripts/test-option-conversation-screen.mjs",
    "test:option-conversation": "npm run test:oc:core && npm run test:oc:branches && npm run test:oc:versioning && npm run test:oc:history && npm run test:oc:screen",
    "test:offline:queue": "node scripts/test-offline-queue.mjs",
    "test:offline:projection": "node scripts/test-offline-projection.mjs",
    "test:offline:idempotency": "node scripts/test-offline-idempotency.mjs",
    "test:offline:sync-endpoints": "node scripts/test-offline-sync-endpoints.mjs",
    "test:offline": "npm run test:offline:queue && npm run test:offline:projection && npm run test:offline:sync-endpoints",
    "test:ui": "playwright test",
    "test:ui:oc": "playwright test tests/e2e/option-conversation-",
    "test:ui:lotes": "node scripts/run-e2e-batches.mjs",
    "test:ui:shell": "playwright test tests/e2e/offline-app-shell.spec.ts",
    "test:ui:sync": "playwright test tests/e2e/offline-sync.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@elevenlabs/react": "^1.10.0",
    "@types/three": "^0.185.1",
    "firebase-admin": "^14.1.0",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
